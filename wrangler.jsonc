{
  "name": "ctgwarroom",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  // Băm ACCESS_PASSWORD (biến Build trên Cloudflare) vào generated/password.js.
  "build": { "command": "node scripts/build-password.mjs" },
  "assets": {
    // Dashboard: public/index.html
    "directory": "./public",
    "binding": "ASSETS",
    // Mọi request đều qua Worker trước để kiểm tra mật khẩu.
    "run_worker_first": true
  },
  // Lịch họp Chủ tịch (src/bookings.js). Lần deploy đầu, wrangler tự tạo database theo tên này.
  "d1_databases": [{ "binding": "DB", "database_name": "ctgwarroom" }]
}
