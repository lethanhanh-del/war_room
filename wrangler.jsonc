{
  "name": "ctgwarroom",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  // Băm ACCESS_PASSWORD (biến Build trên Cloudflare) vào generated/password.js.
  "build": { "command": "node scripts/build-password.mjs" },
  "assets": {
    // Dashboard: public/index.html
    "directory": "./public",
    "binding": "ASSETS",
    // Mọi request đều qua Worker trước để kiểm tra mật khẩu.
    "run_worker_first": true
  },
  // Lịch họp Chủ tịch (src/bookings.js). Lần deploy đầu, wrangler tự tạo database theo tên này.
  "d1_databases": [{ "binding": "DB", "database_name": "ctgwarroom" }],
  // Đẩy thông báo thời gian thực qua WebSocket (src/live.js). SQLite Durable Object chạy được trên gói Free.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  // Mỗi phút đọc lại Google Sheet WR - MASTER TASK lên dashboard "Tiến độ dòng tiền" (src/excel/sheet-sync.js).
  "triggers": { "crons": ["* * * * *"] }
}
