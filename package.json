{
  "name": "ctg-warroom",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard War Room – Tiến độ dòng tiền (CT Worksuite) trên Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "wrangler dev --compatibility-date=2026-11-11",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "setup-sheet": "node --env-file-if-exists=.env scripts/setup-sheet.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
