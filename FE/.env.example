# ===== Google Sheet (DB, chỉ đọc) =====
# ID của Google Sheet: phần giữa /d/ và /edit trong URL
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Service Account (lấy từ file JSON key tải về ở Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Dán nguyên private_key, giữ các ký tự \n (đặt trong dấu nháy kép)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (Tuỳ chọn) Danh sách 5 sheet hiển thị ở ô 2..6, phân cách bằng dấu |
# Bỏ trống = dùng mặc định:
#   DÒNG TIỀN BÁN 4 DỰ ÁN|DÒNG TIỀN NỢ KHÓ ĐÒI|DÒNG TIỀN BANKING|Dòng tiền tài chính|Dòng tiền thu trước hạn quá hạn
# (So khớp không phân biệt hoa/thường, dấu cách thừa.)
CASHFLOW_SHEETS=

# (Tuỳ chọn) Số giây cache dữ liệu Google Sheet phía server, mặc định 30
CACHE_SECONDS=30

# ===== Bảo vệ truy cập =====
# Nếu đặt giá trị, màn hình sẽ hỏi access key (hoặc mở 1 lần bằng URL ?key=<giá trị>).
# Nên đặt khi deploy public trên Vercel.
APP_ACCESS_KEY=

# ===== Chỉ dùng khi dev local =====
# true = dùng dữ liệu giả, không cần Google Sheet
MOCK_SHEETS=false
