# ==== War Room – 10 Dòng tiền · cấu hình ====
# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# --- Nguồn dữ liệu ---
# Để trống SPREADSHEET_ID -> chạy chế độ DEMO (dữ liệu mẫu trong bộ nhớ, không lưu).
SPREADSHEET_ID=
# File khoá service account đặt tại ./secrets/service-account.json (docker-compose tự gắn vào container).
# Khi chạy ngoài Docker: GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# --- CT Worksuite: dashboard "Tiến độ dòng tiền" (trang chủ /) ---
# Đăng nhập bằng 1 tài khoản CHỈ CÓ QUYỀN XEM Project, Task, Employee. Chọn 1 trong 2 cách:
#   (a) API key/secret (Worksuite > tài khoản > API Access > Generate Keys) — ưu tiên nếu có
#   (b) tài khoản + mật khẩu Worksuite (không bật OTP). Sai mật khẩu -> tự ngừng thử 10 phút.
# Để trống cả hai -> trang báo "Chưa kết nối", xem mẫu ở /?demo=1.
# Dùng thẳng domain cterp.ctgrouphitech.com (domain ctgroupvietnam.com chuyển hướng sẽ làm rơi thông tin đăng nhập).
WORKSUITE_URL=https://cterp.ctgrouphitech.com/worksuite
WORKSUITE_API_KEY=
WORKSUITE_API_SECRET=
WORKSUITE_USERNAME=
WORKSUITE_PASSWORD=
# Mã dự án War Room trên Worksuite. Bỏ trống -> tự tìm dự án tên "WAR ROOM" đang chạy.
# Dòng tiền = task cấp cao nhất có tiêu đề "Dòng tiền …"; PIC = người thực hiện task đó; task con = việc của từng người.
WORKSUITE_PROJECT=PROJ-0536
# Giữ kết quả bao nhiêu giây trước khi đọc lại Worksuite (tối thiểu 15)
WORKSUITE_CACHE_SECONDS=60

# --- Thư mục Drive cho AI đọc (Tầng 1) — chia sẻ quyền Xem cho service account ---
# Thư mục chứa biên bản họp (BBH), báo cáo ngày
DRIVE_DOCS_FOLDER_ID=
# Thư mục Chứng từ — đặt tên file/thư mục con theo mã mục tiêu, vd: MT-04_sao-ke.pdf
DRIVE_EVIDENCE_FOLDER_ID=

# --- AI (Claude) — để trống thì tắt AI; báo cáo ngày dùng mẫu tự động ---
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACT=claude-opus-5-5
AI_MODEL_REPORT=claude-opus-5-5
AI_EFFORT_EXTRACT=low
AI_EFFORT_REPORT=medium

# --- Time-box War Room (giờ Việt Nam) ---
WAR_ROOM_START=21/11/2026 07:30
WAR_ROOM_END=25/11/2026 23:59
SHIFT_DAY_START=07:30
SHIFT_NIGHT_START=19:30
# Quá số phút này không ai sửa Sổ -> nguyên tắc REAL-TIME chuyển đỏ
STALE_MINUTES=60

# --- Nhịp chạy ---
POLL_SECONDS=20
SCAN_MINUTES=5
REPORT_TIME=18:00
CLIENT_REFRESH_SECONDS=30
MAX_FILES_PER_SCAN=5

# --- Bảo vệ ---
# Mã PIN cho người vận hành (thêm/sửa/loại mục tiêu, duyệt đề xuất). Để trống = chỉ xem.
OPERATOR_PIN=
# Mật khẩu cho toàn bộ trang (tuỳ chọn) — nên bật nếu mở ra ngoài mạng nội bộ
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Cổng trên máy chủ
HOST_PORT=8080
